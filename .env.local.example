# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Sports Data API
ODDS_API_KEY=your_odds_api_key
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Stats API (API-SPORTS)
STATS_API_KEY=your_stats_api_key
STATS_API_BASE_URL=https://v1.basketball.api-sports.io

# Cron & Security (auto-generated by Vercel)
CRON_SECRET=auto_set_by_vercel
ADMIN_API_KEY=generate_a_secure_random_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging (optional)
LOG_LEVEL=info
